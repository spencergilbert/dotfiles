{
  "externalEditor": "nvim",
  "theme": "system",
  "quietStartup": "header",
  "defaultTools": [
    "+codemode"
  ],
  "defaultThinkingLevel": "medium",
  "packages": [
    "https://github.com/earendil-works/pi-review",
    "npm:@brainrot.xyz/pi-pkg"
  ],
  "showCacheMissNotices": true,
  "npmCommand": [
    "mise",
    "exec",
    "node@lts",
    "--",
    "npm"
  ],
  "hideThinkingBlock": false
}
