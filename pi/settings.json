{
  "externalEditor": "nvim",
  "theme": "catppuccin-frappe",
  "quietStartup": true,
  "defaultThinkingLevel": "medium",
{%- if os() == "macos" %}
  "defaultProvider": "openai",
  "defaultModel": "gpt-5.6-sol",
  "enabledModels": [],
{%- else %}
  "defaultProvider": "llama.cpp",
  "defaultModel": "qwen3.6-35b-a3b",
  "enabledModels": [
    "ds4/**",
    "llama.cpp/**",
    "opencode-go/**"
  ],
{%- endif %}
  "packages": [
    "https://tangled.org/spencergilbert.dev/pi-pkg",
    "npm:pi-mcp-adapter"
  ],
  "showCacheMissNotices": true,
  "npmCommand": [
    "mise",
    "exec",
    "node@lts",
    "--",
    "npm"
  ]
}
