{
  "externalEditor": "nvim",
  "theme": "catppuccin-frappe",
{%- if os() == "macos" %}
  "defaultProvider": "openai",
  "enabledModels": [],
  "packages": [],
{%- else %}
  "defaultProvider": "opencode-go",
  "defaultModel": "deepseek-v4-flash",
  "defaultThinkingLevel": "high",
  "enabledModels": [
    "deepseek-v4-*",
    "opencode-go/**"
  ],
  "packages": [
    "~/src/github.com/spencergilbert/pi-pkg"
  ],
{%- endif %}
  "showCacheMissNotices": true,
  "npmCommand": [
    "mise",
    "exec",
    "node@lts",
    "--",
    "npm"
  ]
}
