{
  "llama.cpp": {
    "type": "api_key",
    "env": {
      "LLAMA_BASE_URL": "http://desktop:9931"
    }
  },
{%- if os() == "macos" %}
  "anthropic": {
    "type": "api_key",
    "key": "!op read 'op://Employee/Pi/anthropic'"
  },
  "openai": {
    "type": "api_key",
    "key": "!op read 'op://Employee/Pi/openai'"
  }
{%- else %}
  "opencode-go": {
    "type": "api_key",
    "key": "!op read 'op://Private/Pi/opencode-go'"
  },
  "qwen-token-plan": {
    "type": "api_key",
    "key": "!op read 'op://Private/Pi/qwen-token-plan'"
  }
{%- endif %}
}
